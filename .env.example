# ── Required API keys ──────────────────────────────────────────────────────────
# OpenAI API key — used for gpt-4o-mini answer generation
OPENAI_API_KEY=sk-...

# Cohere API key — used for rerank-english-v3.0 cross-encoder re-ranking
COHERE_API_KEY=...

# ── ChromaDB connection (defaults work with docker-compose) ────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Chunking (optional overrides) ─────────────────────────────────────────────
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100

# ── Retrieval (optional overrides) ────────────────────────────────────────────
# TOP_K_RETRIEVAL=20
# TOP_K_RERANK=5

# ── Evaluation thresholds (optional overrides) ────────────────────────────────
# MIN_FAITHFULNESS=0.85
# MIN_PRECISION_AT_5=0.70
